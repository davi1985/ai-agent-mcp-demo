# Free LLM inference on Groq — sign up at https://console.groq.com (no credit card)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx

# URL of the MCP server's HTTP endpoint
# Local:     http://localhost:3000/mcp
# Render:    https://<your-app>.onrender.com/mcp
MCP_SERVER_URL=http://localhost:3000/mcp

# Model served by Groq (default has strong tool-calling support)
MODEL=qwen/qwen3.8-27b